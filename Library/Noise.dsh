        float n = BLNoise_snoise_3d(q);
        float signal = (n + offset) * pwr;
        pwr *= roughness;
        value += weight * signal;
        weight *= gain * signal;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if ((rmd != 0.0) && (weight > 0.001)) {
        weight = min(weight, 1.0);
        float n2 = BLNoise_snoise_3d(q);
        float signal2 = (n2 + offset) * pwr;
        value += rmd * weight * signal2;
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_hybrid_mf_4d(float4 p, float detail, float roughness, float lacunarity, float offset, float gain)
{
    float result = (float)0;
    float4 q = p;
    float pwr = 1.0;
    float value = 0.0;
    float weight = 1.0;

    // The weight test is part of the loop condition upstream, not a late-out — once the weight
    // collapses the remaining octaves are skipped entirely, and the fractional-detail tail below
    // is gated on the same test.
    int octaves = int(detail);
    for (int i = 0; (weight > 0.001) && (i <= octaves); i++) {
        weight = min(weight, 1.0);

        float n = BLNoise_snoise_4d(q);
        float signal = (n + offset) * pwr;
        pwr *= roughness;
        value += weight * signal;
        weight *= gain * signal;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if ((rmd != 0.0) && (weight > 0.001)) {
        weight = min(weight, 1.0);
        float n2 = BLNoise_snoise_4d(q);
        float signal2 = (n2 + offset) * pwr;
        value += rmd * weight * signal2;
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_ridged_mf_1d(float p, float detail, float roughness, float lacunarity, float offset, float gain)
{
    float result = (float)0;
    float q = p;
    float pwr = roughness;

    float n0 = BLNoise_snoise_1d(q);
    float signal = offset - abs(n0);
    signal *= signal;
    float value = signal;
    float weight = 1.0;

    // Upstream has no fractional-detail tail here — ridged ignores the remainder. Kept as-is.
    int octaves = int(detail);
    for (int i = 1; i <= octaves; i++) {
        q *= lacunarity;
        weight = saturate(signal * gain);
        float n = BLNoise_snoise_1d(q);
        signal = offset - abs(n);
        signal *= signal;
        signal *= weight;
        value += signal * pwr;
        pwr *= roughness;
    }

    result = value;
    return result;
}

