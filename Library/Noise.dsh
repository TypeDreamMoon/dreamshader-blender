        result = BLNoise_fbm_3d(p, detail, roughness, lacunarity, normalize01);
    }
    else if (type < 1.5) {
        result = BLNoise_multi_fractal_3d(p, detail, roughness, lacunarity);
    }
    else if (type < 2.5) {
        result = BLNoise_hybrid_mf_3d(p, detail, roughness, lacunarity, offset, gain);
    }
    else if (type < 3.5) {
        result = BLNoise_ridged_mf_3d(p, detail, roughness, lacunarity, offset, gain);
    }
    else {
        result = BLNoise_hetero_terrain_3d(p, detail, roughness, lacunarity, offset);
    }
    return result;
}

/// @custom
float BLNoise_select_4d(float4 p, float detail, float roughness, float lacunarity, float offset, float gain, float type, float normalize01)
{
    float result = (float)0;
    if (type < 0.5) {
        result = BLNoise_fbm_4d(p, detail, roughness, lacunarity, normalize01);
    }
    else if (type < 1.5) {
        result = BLNoise_multi_fractal_4d(p, detail, roughness, lacunarity);
