float BLNoise_multi_fractal_3d(float3 p, float detail, float roughness, float lacunarity)
{
    float result = (float)0;
    float3 q = p;
    float value = 1.0;
    float pwr = 1.0;

    int octaves = int(detail);
    for (int i = 0; i <= octaves; i++) {
        float n = BLNoise_snoise_3d(q);
        value *= (pwr * n + 1.0);
        pwr *= roughness;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if (rmd != 0.0) {
        float n2 = BLNoise_snoise_3d(q);
        value *= (rmd * pwr * n2 + 1.0);
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_multi_fractal_4d(float4 p, float detail, float roughness, float lacunarity)
{
    float result = (float)0;
    float4 q = p;
    float value = 1.0;
    float pwr = 1.0;

    int octaves = int(detail);
    for (int i = 0; i <= octaves; i++) {
        float n = BLNoise_snoise_4d(q);
        value *= (pwr * n + 1.0);
        pwr *= roughness;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if (rmd != 0.0) {
        float n2 = BLNoise_snoise_4d(q);
        value *= (rmd * pwr * n2 + 1.0);
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_hetero_terrain_1d(float p, float detail, float roughness, float lacunarity, float offset)
{
    float result = (float)0;
    float q = p;
    float pwr = roughness;

    // First octave is unscaled; the rest are scaled by it. Note the loop starts at 1.
    float n0 = BLNoise_snoise_1d(q);
    float value = offset + n0;
    q *= lacunarity;

    int octaves = int(detail);
    for (int i = 1; i <= octaves; i++) {
        float n = BLNoise_snoise_1d(q);
        float increment = (n + offset) * pwr * value;
        value += increment;
        pwr *= roughness;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if (rmd != 0.0) {
        float n2 = BLNoise_snoise_1d(q);
        float increment2 = (n2 + offset) * pwr * value;
        value += rmd * increment2;
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_hetero_terrain_2d(float2 p, float detail, float roughness, float lacunarity, float offset)
{
    float result = (float)0;
    float2 q = p;
    float pwr = roughness;

    // First octave is unscaled; the rest are scaled by it. Note the loop starts at 1.
    float n0 = BLNoise_snoise_2d(q);
    float value = offset + n0;
    q *= lacunarity;

    int octaves = int(detail);
    for (int i = 1; i <= octaves; i++) {
        float n = BLNoise_snoise_2d(q);
        float increment = (n + offset) * pwr * value;
        value += increment;
        pwr *= roughness;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if (rmd != 0.0) {
        float n2 = BLNoise_snoise_2d(q);
        float increment2 = (n2 + offset) * pwr * value;
        value += rmd * increment2;
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_hetero_terrain_3d(float3 p, float detail, float roughness, float lacunarity, float offset)
{
    float result = (float)0;
    float3 q = p;
    float pwr = roughness;

    // First octave is unscaled; the rest are scaled by it. Note the loop starts at 1.
    float n0 = BLNoise_snoise_3d(q);
    float value = offset + n0;
    q *= lacunarity;

    int octaves = int(detail);
    for (int i = 1; i <= octaves; i++) {
        float n = BLNoise_snoise_3d(q);
        float increment = (n + offset) * pwr * value;
        value += increment;
        pwr *= roughness;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if (rmd != 0.0) {
        float n2 = BLNoise_snoise_3d(q);
        float increment2 = (n2 + offset) * pwr * value;
        value += rmd * increment2;
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_hetero_terrain_4d(float4 p, float detail, float roughness, float lacunarity, float offset)
{
    float result = (float)0;
    float4 q = p;
    float pwr = roughness;

    // First octave is unscaled; the rest are scaled by it. Note the loop starts at 1.
    float n0 = BLNoise_snoise_4d(q);
    float value = offset + n0;
    q *= lacunarity;

    int octaves = int(detail);
    for (int i = 1; i <= octaves; i++) {
        float n = BLNoise_snoise_4d(q);
        float increment = (n + offset) * pwr * value;
        value += increment;
        pwr *= roughness;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if (rmd != 0.0) {
        float n2 = BLNoise_snoise_4d(q);
        float increment2 = (n2 + offset) * pwr * value;
        value += rmd * increment2;
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_hybrid_mf_1d(float p, float detail, float roughness, float lacunarity, float offset, float gain)
{
    float result = (float)0;
    float q = p;
    float pwr = 1.0;
    float value = 0.0;
    float weight = 1.0;

    // The weight test is part of the loop condition upstream, not a late-out — once the weight
    // collapses the remaining octaves are skipped entirely, and the fractional-detail tail below
    // is gated on the same test.
    int octaves = int(detail);
    for (int i = 0; (weight > 0.001) && (i <= octaves); i++) {
        weight = min(weight, 1.0);

        float n = BLNoise_snoise_1d(q);
        float signal = (n + offset) * pwr;
        pwr *= roughness;
        value += weight * signal;
        weight *= gain * signal;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if ((rmd != 0.0) && (weight > 0.001)) {
        weight = min(weight, 1.0);
        float n2 = BLNoise_snoise_1d(q);
        float signal2 = (n2 + offset) * pwr;
        value += rmd * weight * signal2;
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_hybrid_mf_2d(float2 p, float detail, float roughness, float lacunarity, float offset, float gain)
{
    float result = (float)0;
    float2 q = p;
    float pwr = 1.0;
    float value = 0.0;
    float weight = 1.0;

    // The weight test is part of the loop condition upstream, not a late-out — once the weight
    // collapses the remaining octaves are skipped entirely, and the fractional-detail tail below
    // is gated on the same test.
    int octaves = int(detail);
    for (int i = 0; (weight > 0.001) && (i <= octaves); i++) {
        weight = min(weight, 1.0);

        float n = BLNoise_snoise_2d(q);
        float signal = (n + offset) * pwr;
        pwr *= roughness;
        value += weight * signal;
        weight *= gain * signal;
        q *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if ((rmd != 0.0) && (weight > 0.001)) {
        weight = min(weight, 1.0);
        float n2 = BLNoise_snoise_2d(q);
        float signal2 = (n2 + offset) * pwr;
        value += rmd * weight * signal2;
    }

    result = value;
    return result;
}

/// @custom
float BLNoise_hybrid_mf_3d(float3 p, float detail, float roughness, float lacunarity, float offset, float gain)
{
    float result = (float)0;
    float3 q = p;
    float pwr = 1.0;
    float value = 0.0;
    float weight = 1.0;

    // The weight test is part of the loop condition upstream, not a late-out — once the weight
    // collapses the remaining octaves are skipped entirely, and the fractional-detail tail below
    // is gated on the same test.
    int octaves = int(detail);
    for (int i = 0; (weight > 0.001) && (i <= octaves); i++) {
