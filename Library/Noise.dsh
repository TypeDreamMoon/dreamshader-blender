    // Upstream has no fractional-detail tail here — ridged ignores the remainder. Kept as-is.
    int octaves = int(detail);
    for (int i = 1; i <= octaves; i++) {
        q *= lacunarity;
        weight = saturate(signal * gain);
        float n = BLNoise_snoise_2d(q);
        signal = offset - abs(n);
