        result = BLNoise_hetero_terrain_4d(p, detail, roughness, lacunarity, offset);
    }
    return result;
}

// ---------------------------------------------------------------------------------------------
// Seed offsets
//
// Blender's noise functions take no seed, so the node fakes one by offsetting the coordinate.
// The components land in [100, 200]: high enough to decorrelate, low enough not to wreck
// precision. The 2D/3D/4D variants all hash a float2 — that is upstream's choice, not a typo.
// ---------------------------------------------------------------------------------------------

/// @custom
float BLNoise_rand_offset_1d(float seed)
{
    float result = (float)0;
    result = 100.0 + BLHash_float1_to_float(seed) * 100.0;
    return result;
}

/// @custom
float2 BLNoise_rand_offset_2d(float seed)
{
    float2 result = (float2)0;
    result = float2(100.0 + BLHash_float2_to_float(float2(seed, 0.0)) * 100.0,
                    100.0 + BLHash_float2_to_float(float2(seed, 1.0)) * 100.0);
    return result;
}

/// @custom
float3 BLNoise_rand_offset_3d(float seed)
{
    float3 result = (float3)0;
    result = float3(100.0 + BLHash_float2_to_float(float2(seed, 0.0)) * 100.0,
                    100.0 + BLHash_float2_to_float(float2(seed, 1.0)) * 100.0,
                    100.0 + BLHash_float2_to_float(float2(seed, 2.0)) * 100.0);
    return result;
}

/// @custom
float4 BLNoise_rand_offset_4d(float seed)
{
    float4 result = (float4)0;
    result = float4(100.0 + BLHash_float2_to_float(float2(seed, 0.0)) * 100.0,
                    100.0 + BLHash_float2_to_float(float2(seed, 1.0)) * 100.0,
                    100.0 + BLHash_float2_to_float(float2(seed, 2.0)) * 100.0,
                    100.0 + BLHash_float2_to_float(float2(seed, 3.0)) * 100.0);
    return result;
}

// ---------------------------------------------------------------------------------------------
// The node, once per dimension
//
// Both public entry points delegate here, so the distortion pass and the Color-output
// seeding exist in one place. `detail` is clamped to [0, 15] and `roughness` floored at 0
// here rather than in the fractal functions, matching where svm_node_tex_noise does it.
// ---------------------------------------------------------------------------------------------

/// @custom
float BLNoise_texture_1d(float w, float scale, float detail, float roughness, float lacunarity, float offset, float gain, float distortion, float type, float normalize01, out float3 color)
{
    float fac = (float)0;
    float d = clamp(detail, 0.0, 15.0);
    float r = max(roughness, 0.0);

    float p = w * scale;
    if (distortion != 0.0) {
        float o0 = BLNoise_rand_offset_1d(0.0);
        float n0 = BLNoise_snoise_1d(p + o0);
        p += n0 * distortion;
    }

    float oc1 = BLNoise_rand_offset_1d(1.0);
    float oc2 = BLNoise_rand_offset_1d(2.0);

    fac = BLNoise_select_1d(p, d, r, lacunarity, offset, gain, type, normalize01);
    float c1 = BLNoise_select_1d(p + oc1, d, r, lacunarity, offset, gain, type, normalize01);
    float c2 = BLNoise_select_1d(p + oc2, d, r, lacunarity, offset, gain, type, normalize01);
    color = float3(fac, c1, c2);
    return fac;
}

/// @custom
float BLNoise_texture_2d(float2 co, float scale, float detail, float roughness, float lacunarity, float offset, float gain, float distortion, float type, float normalize01, out float3 color)
{
    float fac = (float)0;
    float d = clamp(detail, 0.0, 15.0);
    float r = max(roughness, 0.0);

    float2 p = co * scale;
    if (distortion != 0.0) {
        float2 o0 = BLNoise_rand_offset_2d(0.0);
        float2 o1 = BLNoise_rand_offset_2d(1.0);
        float n0 = BLNoise_snoise_2d(p + o0);
        float n1 = BLNoise_snoise_2d(p + o1);
        p += float2(n0 * distortion, n1 * distortion);
    }

    float2 oc1 = BLNoise_rand_offset_2d(2.0);
    float2 oc2 = BLNoise_rand_offset_2d(3.0);

    fac = BLNoise_select_2d(p, d, r, lacunarity, offset, gain, type, normalize01);
    float c1 = BLNoise_select_2d(p + oc1, d, r, lacunarity, offset, gain, type, normalize01);
    float c2 = BLNoise_select_2d(p + oc2, d, r, lacunarity, offset, gain, type, normalize01);
    color = float3(fac, c1, c2);
    return fac;
}

/// @custom
float BLNoise_texture_3d(float3 co, float scale, float detail, float roughness, float lacunarity, float offset, float gain, float distortion, float type, float normalize01, out float3 color)
{
    float fac = (float)0;
    float d = clamp(detail, 0.0, 15.0);
    float r = max(roughness, 0.0);

    float3 p = co * scale;
    if (distortion != 0.0) {
        float3 o0 = BLNoise_rand_offset_3d(0.0);
        float3 o1 = BLNoise_rand_offset_3d(1.0);
        float3 o2 = BLNoise_rand_offset_3d(2.0);
        float n0 = BLNoise_snoise_3d(p + o0);
        float n1 = BLNoise_snoise_3d(p + o1);
        float n2 = BLNoise_snoise_3d(p + o2);
        p += float3(n0 * distortion, n1 * distortion, n2 * distortion);
    }

    float3 oc1 = BLNoise_rand_offset_3d(3.0);
    float3 oc2 = BLNoise_rand_offset_3d(4.0);

    fac = BLNoise_select_3d(p, d, r, lacunarity, offset, gain, type, normalize01);
    float c1 = BLNoise_select_3d(p + oc1, d, r, lacunarity, offset, gain, type, normalize01);
    float c2 = BLNoise_select_3d(p + oc2, d, r, lacunarity, offset, gain, type, normalize01);
    color = float3(fac, c1, c2);
    return fac;
}

/// @custom
float BLNoise_texture_4d(float3 co, float w, float scale, float detail, float roughness, float lacunarity, float offset, float gain, float distortion, float type, float normalize01, out float3 color)
{
    float fac = (float)0;
    float d = clamp(detail, 0.0, 15.0);
    float r = max(roughness, 0.0);

    float4 p = float4(co * scale, w * scale);
    if (distortion != 0.0) {
        float4 o0 = BLNoise_rand_offset_4d(0.0);
        float4 o1 = BLNoise_rand_offset_4d(1.0);
        float4 o2 = BLNoise_rand_offset_4d(2.0);
        float4 o3 = BLNoise_rand_offset_4d(3.0);
        float n0 = BLNoise_snoise_4d(p + o0);
        float n1 = BLNoise_snoise_4d(p + o1);
        float n2 = BLNoise_snoise_4d(p + o2);
        float n3 = BLNoise_snoise_4d(p + o3);
        p += float4(n0 * distortion, n1 * distortion, n2 * distortion, n3 * distortion);
    }

    float4 oc1 = BLNoise_rand_offset_4d(4.0);
    float4 oc2 = BLNoise_rand_offset_4d(5.0);

    fac = BLNoise_select_4d(p, d, r, lacunarity, offset, gain, type, normalize01);
    float c1 = BLNoise_select_4d(p + oc1, d, r, lacunarity, offset, gain, type, normalize01);
    float c2 = BLNoise_select_4d(p + oc2, d, r, lacunarity, offset, gain, type, normalize01);
    color = float3(fac, c1, c2);
    return fac;
}

// ---------------------------------------------------------------------------------------------
// Public API — the Noise Texture node
//
// `TexNoise<N>D`      — fBM, Blender's default type. The common case, short signature.
// `TexNoiseTyped<N>D` — the full node, including the Type dropdown and its Offset/Gain.
//
// Inputs follow the node's own socket order; outputs are Fac then Color. `normalize01`
// is the Normalize checkbox as 0.0 / 1.0 — the language has no bool-valued input.
// ---------------------------------------------------------------------------------------------

/// @custom
/// @name BL::TexNoise1D
void BL_TexNoise1D(float w, float scale, float detail, float roughness, float lacunarity, float distortion, float normalize01, out float fac, out float3 color)
{
    // fBM shorthand: type 0, and offset/gain unused by fBM.
    fac = BLNoise_texture_1d(w, scale, detail, roughness, lacunarity, 0.0, 1.0,
                        distortion, 0.0, normalize01, color);
}

/// @custom
/// @name BL::TexNoise2D
void BL_TexNoise2D(float2 co, float scale, float detail, float roughness, float lacunarity, float distortion, float normalize01, out float fac, out float3 color)
{
    // fBM shorthand: type 0, and offset/gain unused by fBM.
    fac = BLNoise_texture_2d(co, scale, detail, roughness, lacunarity, 0.0, 1.0,
                        distortion, 0.0, normalize01, color);
}

/// @custom
/// @name BL::TexNoise3D
void BL_TexNoise3D(float3 co, float scale, float detail, float roughness, float lacunarity, float distortion, float normalize01, out float fac, out float3 color)
{
    // fBM shorthand: type 0, and offset/gain unused by fBM.
    fac = BLNoise_texture_3d(co, scale, detail, roughness, lacunarity, 0.0, 1.0,
                        distortion, 0.0, normalize01, color);
}

/// @custom
/// @name BL::TexNoise4D
void BL_TexNoise4D(float3 co, float w, float scale, float detail, float roughness, float lacunarity, float distortion, float normalize01, out float fac, out float3 color)
{
    // fBM shorthand: type 0, and offset/gain unused by fBM.
    fac = BLNoise_texture_4d(co, w, scale, detail, roughness, lacunarity, 0.0, 1.0,
                        distortion, 0.0, normalize01, color);
}

/// @custom
/// @name BL::TexNoiseTyped1D
void BL_TexNoiseTyped1D(float w, float scale, float detail, float roughness, float lacunarity, float offset, float gain, float distortion, float type, float normalize01, out float fac, out float3 color)
{
    fac = BLNoise_texture_1d(w, scale, detail, roughness, lacunarity, offset, gain,
                        distortion, type, normalize01, color);
}

/// @custom
/// @name BL::TexNoiseTyped2D
void BL_TexNoiseTyped2D(float2 co, float scale, float detail, float roughness, float lacunarity, float offset, float gain, float distortion, float type, float normalize01, out float fac, out float3 color)
{
    fac = BLNoise_texture_2d(co, scale, detail, roughness, lacunarity, offset, gain,
                        distortion, type, normalize01, color);
}

/// @custom
/// @name BL::TexNoiseTyped3D
void BL_TexNoiseTyped3D(float3 co, float scale, float detail, float roughness, float lacunarity, float offset, float gain, float distortion, float type, float normalize01, out float fac, out float3 color)
