    int octaves = int(detail);
    for (int i = 1; i <= octaves; i++) {
        q *= lacunarity;
        weight = saturate(signal * gain);
        float n = BLNoise_snoise_4d(q);
        signal = offset - abs(n);
        signal *= signal;
        signal *= weight;
        value += signal * pwr;
        pwr *= roughness;
    }

    result = value;
    return result;
}

// ---------------------------------------------------------------------------------------------
// Type dispatch
//
// `type` is a float so it can come from a ScalarParameter or a static switch. The
// encoding is this package's own, ordered to put Blender's default at zero:
//
//   0 fBM  |  1 Multifractal  |  2 Hybrid Multifractal  |  3 Ridged Multifractal
//   4 Hetero Terrain
//
// With a literal or a static-switch `type` the compiler folds the branch and drops the
// four unused paths; only a genuinely dynamic type pays for all five.
// ---------------------------------------------------------------------------------------------

/// @custom
float BLNoise_select_1d(float p, float detail, float roughness, float lacunarity, float offset, float gain, float type, float normalize01)
{
    float result = (float)0;
    if (type < 0.5) {
        result = BLNoise_fbm_1d(p, detail, roughness, lacunarity, normalize01);
    }
    else if (type < 1.5) {
        result = BLNoise_multi_fractal_1d(p, detail, roughness, lacunarity);
    }
    else if (type < 2.5) {
        result = BLNoise_hybrid_mf_1d(p, detail, roughness, lacunarity, offset, gain);
    }
    else if (type < 3.5) {
        result = BLNoise_ridged_mf_1d(p, detail, roughness, lacunarity, offset, gain);
    }
    else {
        result = BLNoise_hetero_terrain_1d(p, detail, roughness, lacunarity, offset);
    }
    return result;
}

/// @custom
float BLNoise_select_2d(float2 p, float detail, float roughness, float lacunarity, float offset, float gain, float type, float normalize01)
{
    float result = (float)0;
    if (type < 0.5) {
        result = BLNoise_fbm_2d(p, detail, roughness, lacunarity, normalize01);
    }
    else if (type < 1.5) {
        result = BLNoise_multi_fractal_2d(p, detail, roughness, lacunarity);
    }
    else if (type < 2.5) {
        result = BLNoise_hybrid_mf_2d(p, detail, roughness, lacunarity, offset, gain);
    }
    else if (type < 3.5) {
        result = BLNoise_ridged_mf_2d(p, detail, roughness, lacunarity, offset, gain);
    }
    else {
        result = BLNoise_hetero_terrain_2d(p, detail, roughness, lacunarity, offset);
    }
    return result;
}

/// @custom
float BLNoise_select_3d(float3 p, float detail, float roughness, float lacunarity, float offset, float gain, float type, float normalize01)
{
    float result = (float)0;
