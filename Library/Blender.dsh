// dreamshader-blender — umbrella header.
//
// Importing this pulls in every node family the package implements. Import an individual header
// instead when you only need one: the import closure is inlined as text, so a narrower import is
// a smaller translation unit, a smaller generated include, and a shorter shader compile.
//
// Diamond imports are safe — a file already inlined in this translation unit is skipped.

#include "Hash.dsh"
#include "Noise.dsh"
#include "WhiteNoise.dsh"
#include "Checker.dsh"
#include "Gradient.dsh"
#include "Magic.dsh"
#include "Wave.dsh"
#include "Brick.dsh"
#include "Voronoi.dsh"
#include "Gabor.dsh"
#include "Math.dsh"
#include "Color.dsh"
#include "Vector.dsh"
#include "Space.dsh"
#include "Tables.dsh"
#include "Curves.dsh"
