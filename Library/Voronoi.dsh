Function BLVor_fractal_d2e_2(in float2 coord, in float detail, in float roughness,
                        in float lacunarity, in float randomness, in float maxDistance,
                        in float normalize01, out float result)
{
    float amplitude = 1.0;
    float maxAmplitude = maxDistance;
    float octaveScale = 1.0;
    float dist = 8.0;

    bool zeroInput = (detail == 0.0) || (roughness == 0.0);

    int octaves = int(ceil(detail));
    for (int i = 0; i <= octaves; i++) {
        float octaveDistance = BLVor_dist_to_edge_2(coord * octaveScale, randomness);

        if (zeroInput) {
            dist = octaveDistance;
            break;
        }

        if (float(i) <= detail) {
            maxAmplitude = lerp(maxAmplitude, maxDistance / octaveScale, amplitude);
            dist = lerp(dist, min(dist, octaveDistance / octaveScale), amplitude);
            octaveScale *= lacunarity;
            amplitude *= roughness;
        }
        else {
            float remainder = detail - floor(detail);
            if (remainder != 0.0) {
                float lerpAmplitude = lerp(maxAmplitude, maxDistance / octaveScale, amplitude);
                maxAmplitude = lerp(maxAmplitude, lerpAmplitude, remainder);
                float lerpDistance = lerp(dist, min(dist, octaveDistance / octaveScale), amplitude);
                dist = lerp(dist, min(dist, lerpDistance), remainder);
            }
        }
    }

    if (normalize01 != 0.0) {
        dist /= maxAmplitude;
    }

    result = dist;
}

