// ---------------------------------------------------------------------------------------------
// Public API — the Voronoi Texture node
//
// One entry point per Feature per dimension. Outputs follow the node's own order:
// Distance, Color, Position, W — minus the ones that feature does not produce.
//
// `metric`: 0 Euclidean | 1 Manhattan | 2 Chebychev | 3 Minkowski. Ignored by
// Distance To Edge, N-Sphere Radius and every 1D entry, as in Blender.
// ---------------------------------------------------------------------------------------------

Namespace(Name = "BL")
{

    Function TexVoronoiF1_1D(in float w, in float scale, in float detail,
                        in float roughness, in float lacunarity, in float randomness,
                        in float metric, in float exponent, in float normalize01,
                        out float outDistance, out float3 outColor, out float3 outPosition,
                        out float outW)
    {
        float dt = clamp(detail, 0.0, 15.0);
        float rg = clamp(roughness, 0.0, 1.0);
        float rnd = clamp(randomness, 0.0, 1.0);
        float p = w * scale;
        float md = 0.5 + 0.5 * rnd;
        float maxDistance = md;
        float dist;
        float3 col;
        float4 pos;
        BLVor_fractal_f1_1(p, dt, rg, lacunarity, rnd, metric, exponent, 0.0,
                                 maxDistance, normalize01, scale, dist, col, pos);

        outDistance = dist;
        outColor = col;
        outPosition = pos.xyz;
        outW = pos.w;
    }

    Function TexVoronoiSmoothF1_1D(in float w, in float scale, in float detail,
                        in float roughness, in float lacunarity, in float smoothness, in float randomness,
                        in float metric, in float exponent, in float normalize01,
                        out float outDistance, out float3 outColor, out float3 outPosition,
                        out float outW)
    {
        float dt = clamp(detail, 0.0, 15.0);
        float rg = clamp(roughness, 0.0, 1.0);
        float rnd = clamp(randomness, 0.0, 1.0);
        float p = w * scale;
        float md = 0.5 + 0.5 * rnd;
        float maxDistance = md;
        float sm = clamp(smoothness / 2.0, 0.0, 0.5);
        float dist;
        float3 col;
        float4 pos;
        if (sm != 0.0) {
            BLVor_fractal_smoothf1_1(p, dt, rg, lacunarity, rnd, metric, exponent, sm,
                                     maxDistance, normalize01, scale, dist, col, pos);
        }
        else {
            BLVor_fractal_f1_1(p, dt, rg, lacunarity, rnd, metric, exponent, 0.0,
                                     maxDistance, normalize01, scale, dist, col, pos);
        }

        outDistance = dist;
        outColor = col;
        outPosition = pos.xyz;
        outW = pos.w;
    }

    Function TexVoronoiF2_1D(in float w, in float scale, in float detail,
                        in float roughness, in float lacunarity, in float randomness,
                        in float metric, in float exponent, in float normalize01,
                        out float outDistance, out float3 outColor, out float3 outPosition,
                        out float outW)
    {
        float dt = clamp(detail, 0.0, 15.0);
        float rg = clamp(roughness, 0.0, 1.0);
        float rnd = clamp(randomness, 0.0, 1.0);
        float p = w * scale;
        float md = 0.5 + 0.5 * rnd;
        float maxDistance = md * 2.0;
        float dist;
        float3 col;
        float4 pos;
        BLVor_fractal_f2_1(p, dt, rg, lacunarity, rnd, metric, exponent, 0.0,
                                 maxDistance, normalize01, scale, dist, col, pos);

        outDistance = dist;
        outColor = col;
        outPosition = pos.xyz;
        outW = pos.w;
    }

    Function TexVoronoiDistToEdge_1D(in float w, in float scale, in float detail,
                        in float roughness, in float lacunarity, in float randomness,
                        in float normalize01, out float outDistance)
    {
        float dt = clamp(detail, 0.0, 15.0);
        float rg = clamp(roughness, 0.0, 1.0);
        float rnd = clamp(randomness, 0.0, 1.0);
        float p = w * scale;
        float maxDistance = 0.5 + 0.5 * rnd;

        outDistance = BLVor_fractal_d2e_1(p, dt, rg, lacunarity, rnd, maxDistance, normalize01);
    }

    // Not fractalised upstream, so there is no detail / roughness / lacunarity here.
    Function TexVoronoiRadius_1D(in float w, in float scale, in float randomness,
                        out float outRadius)
    {
        float rnd = clamp(randomness, 0.0, 1.0);
        float p = w * scale;
        outRadius = BLVor_n_sphere_radius_1(p, rnd);
    }

