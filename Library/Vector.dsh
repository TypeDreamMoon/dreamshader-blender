// Blender's vector nodes: Mapping, Vector Rotate, Normal, Separate/Combine XYZ.
//
// Sources: intern/cycles/kernel/svm/mapping_util.h, vector_rotate.h, normal.h and
// euler_to_transform / rotate_around_axis from intern/cycles/util — Apache-2.0. See NOTICE.
//
// These operate in *Blender's* space. If the coordinate came out of Space.dsh it already is in
// Blender's space, and the result has to go back through the same conversion before it means
// anything to Unreal. See Space.dsh.

#include "Hash.dsh"

// ---------------------------------------------------------------------------------------------
// Euler rotation
//
// Blender's XYZ euler convention, written as three row vectors rather than a matrix because
// DreamShaderLang has no matrix type. The rows are upstream's `t.x`, `t.y`, `t.z`.
// ---------------------------------------------------------------------------------------------

/// @custom
float3 BLVector_euler_rows(float3 euler, out float3 rowY, out float3 rowZ)
{
    float3 rowX = (float3)0;
    float cx = cos(euler.x);
    float cy = cos(euler.y);
    float cz = cos(euler.z);
    float sx = sin(euler.x);
    float sy = sin(euler.y);
    float sz = sin(euler.z);

    rowX = float3(cy * cz, sy * sx * cz - cx * sz, sy * cx * cz + sx * sz);
    rowY = float3(cy * sz, sy * sx * sz + cx * cz, sy * cx * sz - sx * cz);
    rowZ = float3(-sy, cy * sx, cy * cx);
    return rowX;
}

/// @custom
float3 BLVector_transform_dir(float3 rowX, float3 rowY, float3 rowZ, float3 a)
{
    float3 result = (float3)0;
    result = float3(dot(a, rowX), dot(a, rowY), dot(a, rowZ));
    return result;
}

/// @custom
float3 BLVector_transform_dir_transposed(float3 rowX, float3 rowY, float3 rowZ, float3 a)
{
    float3 result = (float3)0;
    float3 cx = float3(rowX.x, rowY.x, rowZ.x);
    float3 cy = float3(rowX.y, rowY.y, rowZ.y);
    float3 cz = float3(rowX.z, rowY.z, rowZ.z);
    result = float3(dot(a, cx), dot(a, cy), dot(a, cz));
    return result;
}

/// @custom
float3 BLVector_rotate_around_axis(float3 p, float3 axis, float angle)
{
    float3 result = (float3)0;
    float c = cos(angle);
    float s = sin(angle);
    float t = 1.0 - c;

    float rx = ((c + t * axis.x * axis.x) * p.x) +
               ((t * axis.x * axis.y - axis.z * s) * p.y) +
               ((t * axis.x * axis.z + axis.y * s) * p.z);
    float ry = ((t * axis.x * axis.y + axis.z * s) * p.x) +
               ((c + t * axis.y * axis.y) * p.y) +
               ((t * axis.y * axis.z - axis.x * s) * p.z);
    float rz = ((t * axis.x * axis.z - axis.y * s) * p.x) +
               ((t * axis.y * axis.z + axis.x * s) * p.y) +
               ((c + t * axis.z * axis.z) * p.z);

    result = float3(rx, ry, rz);
    return result;
}

/// @custom
float3 BLVector_safe_divide3(float3 a, float3 b)
{
    float3 result = (float3)0;
    result = float3((b.x != 0.0) ? a.x / b.x : 0.0,
                    (b.y != 0.0) ? a.y / b.y : 0.0,
                    (b.z != 0.0) ? a.z / b.z : 0.0);
    return result;
}

// ---------------------------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------------------------

// Every public function below is also a material function, for the Material Editor:
// /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Vector/MF_BL_<Name>.
#pragma generate(Functions = "Vector/MF_{Name}", Library = "Blender|Vector")

// Mapping `type`: 0 Point | 1 Texture | 2 Vector | 3 Normal
//
// The four are not variations on a theme. Point applies scale, then rotation, then location.
// Texture is its inverse — subtract location, rotate back, divide by scale — which is why a
// Texture mapping node with the same values undoes a Point one. Vector skips the location
// entirely, and Normal divides by scale before rotating and renormalises.
/// @custom
/// @name BL::Mapping
void BL_Mapping(float type, float3 vec, float3 location, float3 rotation, float3 scale, out float3 result)
{
    float3 rx;
    float3 ry;
    float3 rz;
    rx = BLVector_euler_rows(rotation, ry, rz);

    int t = int(type);
    if (t == 0) {
        float3 d = BLVector_transform_dir(rx, ry, rz, vec * scale);
        result = d + location;
    }
    else if (t == 1) {
        float3 d = BLVector_transform_dir_transposed(rx, ry, rz, vec - location);
        result = BLVector_safe_divide3(d, scale);
    }
    else if (t == 2) {
        result = BLVector_transform_dir(rx, ry, rz, vec * scale);
    }
    else {
        float3 sd = BLVector_safe_divide3(vec, scale);
        float3 d = BLVector_transform_dir(rx, ry, rz, sd);
        float len = length(d);
        result = (len != 0.0) ? (d * (1.0 / len)) : d;
    }
}

// Vector Rotate `type`: 0 Axis Angle | 1 X Axis | 2 Y Axis | 3 Z Axis | 4 Euler XYZ
/// @custom
/// @name BL::VectorRotate
void BL_VectorRotate(float type, float3 vec, float3 center, float3 axis, float angle, float3 rotation, float invert, out float3 result)
{
    int t = int(type);

    if (t == 4) {
        float3 rx;
        float3 ry;
        float3 rz;
        rx = BLVector_euler_rows(rotation, ry, rz);
        if (invert != 0.0) {
            float3 d = BLVector_transform_dir_transposed(rx, ry, rz, vec - center);
            result = d + center;
        }
        else {
            float3 d = BLVector_transform_dir(rx, ry, rz, vec - center);
            result = d + center;
        }
    }
    else {
        float3 ax = axis;
        float axLen = length(axis);
        if (t == 1)      { ax = float3(1.0, 0.0, 0.0); axLen = 1.0; }
        else if (t == 2) { ax = float3(0.0, 1.0, 0.0); axLen = 1.0; }
        else if (t == 3) { ax = float3(0.0, 0.0, 1.0); axLen = 1.0; }

        float a = (invert != 0.0) ? -angle : angle;

        if (axLen != 0.0) {
            float3 r = BLVector_rotate_around_axis(vec - center, ax / axLen, a);
            result = r + center;
        }
        else {
            // A zero-length custom axis is a no-op, not a NaN.
            result = vec;
        }
    }
}

// The Normal node is a direction widget plus a dot product: it always outputs the direction
// it was authored with, and the dot of that against the incoming normal.
/// @custom
/// @name BL::Normal
void BL_Normal(float3 direction, float3 inNormal, out float3 outNormal, out float outDot)
{
    float3 d = normalize(direction);
    outNormal = d;
    outDot = dot(d, normalize(inNormal));
}

/// @custom
/// @name BL::SeparateXYZ
void BL_SeparateXYZ(float3 vec, out float x, out float y, out float z)
{
    x = vec.x;
    y = vec.y;
    z = vec.z;
}

/// @custom
/// @name BL::CombineXYZ
void BL_CombineXYZ(float x, float y, float z, out float3 vec)
{
    vec = float3(x, y, z);
}
