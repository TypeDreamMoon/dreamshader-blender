// Blender's White Noise Texture node (`ShaderNodeTexWhiteNoise`).
//
// Source: intern/cycles/kernel/svm/white_noise.h — Apache-2.0. See NOTICE.
//
// The node is a thin wrapper over the hashes: Value is the scalar hash of the coordinate, Color
// is the float3 hash of the same coordinate. There is no scale input — the coordinate goes in
// unmodified.

#include "Hash.dsh"

// Every public function below is also a material function, for the Material Editor:
// /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/WhiteNoise/MF_BL_<Name>.
#pragma generate(Functions = "WhiteNoise/MF_{Name}", Library = "Blender|WhiteNoise")

/// @custom
/// @name BL::TexWhiteNoise1D
void BL_TexWhiteNoise1D(float w, out float value, out float3 color)
{
    value = BLHash_float1_to_float(w);
    color = BLHash_float1_to_float3(w);
}

/// @custom
/// @name BL::TexWhiteNoise2D
void BL_TexWhiteNoise2D(float2 co, out float value, out float3 color)
{
    value = BLHash_float2_to_float(co);
    color = BLHash_float2_to_float3(co);
}

/// @custom
/// @name BL::TexWhiteNoise3D
void BL_TexWhiteNoise3D(float3 co, out float value, out float3 color)
{
    value = BLHash_float3_to_float(co);
    color = BLHash_float3_to_float3(co);
}

/// @custom
/// @name BL::TexWhiteNoise4D
void BL_TexWhiteNoise4D(float3 co, float w, out float value, out float3 color)
{
    float4 p = float4(co, w);
    value = BLHash_float4_to_float(p);
    color = BLHash_float4_to_float3(p);
}
