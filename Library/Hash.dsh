// Jenkins lookup3 integer hashes, ported from Cycles `intern/cycles/util/hash.h`.
//
// These are the exact hashes Blender's procedural textures are built on. Every value here is
// bit-for-bit identical to the Cycles CPU/GPU kernel, which is what makes a golden-image
// comparison against a Blender render possible at all.
//
// Upstream: SPDX-FileCopyrightText 2011-2022 Blender Foundation, SPDX-License-Identifier Apache-2.0
// See NOTICE at the repository root.
//
// Naming: everything here is a top-level `BLHash_*` helper rather than a namespaced one, because
// a namespace-qualified call inside another Function body is not rewritten by the code generator.
// Only public entry points live in a namespace; internals stay unqualified so siblings can call
// them. Do not rename without re-reading Docs/generation/generated-hlsl.md.

// [0, uint_max] -> [0.0, 1.0]
//
// Upstream is `(float)n * (1.0f / (float)0xFFFFFFFFu)`. Note that `(float)0xFFFFFFFFu` rounds up
// to 4294967296.0f, so the reciprocal is exactly 2^-32 — spelling the constant that way here keeps
// the result bit-identical instead of merely close.
/// @custom
float BLHash_uint_to_float_incl(uint n)
{
    float result = (float)0;
    result = float(n) * (1.0 / 4294967296.0);
    return result;
}

/// @custom
uint BLHash_uint1(uint kx)
{
    uint result = (uint)0;
    uint a = 0xdeadbeefu + 17u;  // 0xdeadbeef + (1 << 2) + 13
    uint b = a;
    uint c = a;

    a += kx;

    // final(a, b, c)
    c ^= b; c -= (b << 14u) | (b >> 18u);
    a ^= c; a -= (c << 11u) | (c >> 21u);
    b ^= a; b -= (a << 25u) | (a >>  7u);
    c ^= b; c -= (b << 16u) | (b >> 16u);
    a ^= c; a -= (c <<  4u) | (c >> 28u);
    b ^= a; b -= (a << 14u) | (a >> 18u);
    c ^= b; c -= (b << 24u) | (b >>  8u);

    result = c;
    return result;
}

/// @custom
uint BLHash_uint2(uint kx, uint ky)
{
    uint result = (uint)0;
    uint a = 0xdeadbeefu + 21u;  // 0xdeadbeef + (2 << 2) + 13
    uint b = a;
    uint c = a;

    b += ky;
    a += kx;

    // final(a, b, c)
    c ^= b; c -= (b << 14u) | (b >> 18u);
    a ^= c; a -= (c << 11u) | (c >> 21u);
    b ^= a; b -= (a << 25u) | (a >>  7u);
    c ^= b; c -= (b << 16u) | (b >> 16u);
    a ^= c; a -= (c <<  4u) | (c >> 28u);
    b ^= a; b -= (a << 14u) | (a >> 18u);
    c ^= b; c -= (b << 24u) | (b >>  8u);

    result = c;
    return result;
}

/// @custom
uint BLHash_uint3(uint kx, uint ky, uint kz)
{
    uint result = (uint)0;
    uint a = 0xdeadbeefu + 25u;  // 0xdeadbeef + (3 << 2) + 13
    uint b = a;
    uint c = a;

    c += kz;
    b += ky;
    a += kx;

    // final(a, b, c)
    c ^= b; c -= (b << 14u) | (b >> 18u);
    a ^= c; a -= (c << 11u) | (c >> 21u);
    b ^= a; b -= (a << 25u) | (a >>  7u);
    c ^= b; c -= (b << 16u) | (b >> 16u);
    a ^= c; a -= (c <<  4u) | (c >> 28u);
    b ^= a; b -= (a << 14u) | (a >> 18u);
    c ^= b; c -= (b << 24u) | (b >>  8u);

    result = c;
    return result;
}

/// @custom
uint BLHash_uint4(uint kx, uint ky, uint kz, uint kw)
{
    uint result = (uint)0;
    uint a = 0xdeadbeefu + 29u;  // 0xdeadbeef + (4 << 2) + 13
    uint b = a;
    uint c = a;

    a += kx;
    b += ky;
    c += kz;

    // mix(a, b, c) — spelled out because the upstream macro name collides with the
    // GLSL-to-HLSL identifier rewrite applied to Function bodies (`mix` becomes `lerp`).
    a -= c; a ^= (c <<  4u) | (c >> 28u); c += b;
    b -= a; b ^= (a <<  6u) | (a >> 26u); a += c;
    c -= b; c ^= (b <<  8u) | (b >> 24u); b += a;
    a -= c; a ^= (c << 16u) | (c >> 16u); c += b;
    b -= a; b ^= (a << 19u) | (a >> 13u); a += c;
    c -= b; c ^= (b <<  4u) | (b >> 28u); b += a;

    a += kw;

    // final(a, b, c)
    c ^= b; c -= (b << 14u) | (b >> 18u);
    a ^= c; a -= (c << 11u) | (c >> 21u);
    b ^= a; b -= (a << 25u) | (a >>  7u);
    c ^= b; c -= (b << 16u) | (b >> 16u);
    a ^= c; a -= (c <<  4u) | (c >> 28u);
    b ^= a; b -= (a << 14u) | (a >> 18u);
    c ^= b; c -= (b << 24u) | (b >>  8u);

    result = c;
    return result;
}

// Hashing a float or float2 into a float in the range [0, 1].
//
// Upstream reinterprets the float's bits (`__float_as_uint`), it does not convert the value —
// `asuint` is the HLSL spelling of the same reinterpretation.
//
// Every call below is hoisted into its own local. A call to a sibling Function may NOT appear
// inside another sibling call's argument list: the generator rewrites only the outermost call in
// an expression and leaves everything in its arguments untouched, which emits a reference to an
// undefined `BLHash_uint1(...)`. Nesting inside an HLSL intrinsic or constructor is fine — it is
// specifically sibling-inside-sibling that breaks. See README.md, "Porting rules".
/// @custom
float BLHash_float1_to_float(float k)
{
    float result = (float)0;
    uint h = BLHash_uint1(asuint(k));
    result = BLHash_uint_to_float_incl(h);
    return result;
}

/// @custom
float BLHash_float2_to_float(float2 k)
{
    float result = (float)0;
    uint h = BLHash_uint2(asuint(k.x), asuint(k.y));
    result = BLHash_uint_to_float_incl(h);
    return result;
}

/// @custom
float BLHash_float3_to_float(float3 k)
{
    float result = (float)0;
    uint h = BLHash_uint3(asuint(k.x), asuint(k.y), asuint(k.z));
    result = BLHash_uint_to_float_incl(h);
    return result;
}

/// @custom
float BLHash_float4_to_float(float4 k)
{
    float result = (float)0;
    uint h = BLHash_uint4(asuint(k.x), asuint(k.y), asuint(k.z), asuint(k.w));
    result = BLHash_uint_to_float_incl(h);
    return result;
}

// ---------------------------------------------------------------------------------------------
// PCG 2D / 3D / 4D
//
// From "Hash Functions for GPU Rendering", JCGT 2020. Upstream modified them to use only *signed*
// integers so the same hash is expressible in OSL, and that is not cosmetic: `v >> 16` on a signed
// int is an arithmetic shift, and these are declared `int` here for exactly that reason. Switching
// to uint would silently change every Voronoi cell.
//
// The wraparound in the multiplies is intended — upstream marks these functions as
// overflow-ignoring. HLSL int arithmetic already wraps.
// ---------------------------------------------------------------------------------------------

/// @custom
int2 BLHash_pcg2d_i(int2 k)
{
    int2 result = (int2)0;
    int2 v = k * 1664525 + 1013904223;
    v.x += v.y * 1664525;
    v.y += v.x * 1664525;
    v = v ^ (v >> 16);
    v.x += v.y * 1664525;
    v.y += v.x * 1664525;
    result = v & 0x7FFFFFFF;
    return result;
}

/// @custom
int3 BLHash_pcg3d_i(int3 k)
{
    int3 result = (int3)0;
    int3 v = k * 1664525 + 1013904223;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v = v ^ (v >> 16);
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    result = v & 0x7FFFFFFF;
    return result;
}

/// @custom
int4 BLHash_pcg4d_i(int4 k)
{
    int4 result = (int4)0;
    int4 v = k * 1664525 + 1013904223;
    v.x += v.y * v.w;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v.w += v.y * v.z;
    v = v ^ (v >> 16);
    v.x += v.y * v.w;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v.w += v.y * v.z;
    result = v & 0x7FFFFFFF;
    return result;
}

// The divisor is 2^31, not 0x7FFFFFFF: upstream divides by `(float)0x7FFFFFFFu`, which rounds up.
/// @custom
float2 BLHash_int2_to_float2(int2 k)
{
    float2 result = (float2)0;
    int2 h = BLHash_pcg2d_i(k);
    result = float2(float(h.x), float(h.y)) * (1.0 / 2147483648.0);
    return result;
}

/// @custom
float3 BLHash_int3_to_float3(int3 k)
{
    float3 result = (float3)0;
    int3 h = BLHash_pcg3d_i(k);
    result = float3(float(h.x), float(h.y), float(h.z)) * (1.0 / 2147483648.0);
    return result;
}

/// @custom
float4 BLHash_int4_to_float4(int4 k)
{
    float4 result = (float4)0;
    int4 h = BLHash_pcg4d_i(k);
    result = float4(float(h.x), float(h.y), float(h.z), float(h.w)) * (1.0 / 2147483648.0);
    return result;
}

/// @custom
float3 BLHash_int2_to_float3(int2 k)
{
    float3 result = (float3)0;
    result = BLHash_int3_to_float3(int3(k.x, k.y, 0));
    return result;
}

/// @custom
float3 BLHash_int4_to_float3(int4 k)
{
    float3 result = (float3)0;
    float4 h = BLHash_int4_to_float4(k);
    result = h.xyz;
    return result;
}

// Hashing a float or floatN into a float3 of components in [0, 1].
//
// The component recipes look arbitrary because they are: upstream keeps this exact behaviour to
// stay reproducible in OSL, which has neither bit casts nor unsigned integers. A "cleaner" set of
// seeds would be a different texture.
/// @custom
float3 BLHash_float1_to_float3(float k)
{
    float3 result = (float3)0;
    float a = BLHash_float1_to_float(k);
    float b = BLHash_float2_to_float(float2(k, 1.0));
    float c = BLHash_float2_to_float(float2(k, 2.0));
    result = float3(a, b, c);
    return result;
}

/// @custom
float3 BLHash_float2_to_float3(float2 k)
{
    float3 result = (float3)0;
    float a = BLHash_float2_to_float(k);
    float b = BLHash_float3_to_float(float3(k.x, k.y, 1.0));
    float c = BLHash_float3_to_float(float3(k.x, k.y, 2.0));
    result = float3(a, b, c);
    return result;
}

/// @custom
float3 BLHash_float3_to_float3(float3 k)
{
    float3 result = (float3)0;
    float a = BLHash_float3_to_float(k);
    float b = BLHash_float4_to_float(float4(k.x, k.y, k.z, 1.0));
    float c = BLHash_float4_to_float(float4(k.x, k.y, k.z, 2.0));
    result = float3(a, b, c);
    return result;
}

/// @custom
float3 BLHash_float4_to_float3(float4 k)
{
    float3 result = (float3)0;
    float a = BLHash_float4_to_float(k);
    float b = BLHash_float4_to_float(float4(k.z, k.x, k.w, k.y));
    float c = BLHash_float4_to_float(float4(k.w, k.z, k.y, k.x));
    result = float3(a, b, c);
    return result;
}

// Hashing a floatN into a float2 of components in [0, 1]. Same arbitrary-looking component
// recipes, same reason.
/// @custom
float2 BLHash_float3_to_float2(float3 k)
{
    float2 result = (float2)0;
    float a = BLHash_float3_to_float(k);
    float b = BLHash_float3_to_float(float3(k.z, k.x, k.y));
    result = float2(a, b);
    return result;
}

/// @custom
float2 BLHash_float4_to_float2(float4 k)
{
    float2 result = (float2)0;
    float a = BLHash_float4_to_float(k);
    float b = BLHash_float4_to_float(float4(k.z, k.x, k.w, k.y));
    result = float2(a, b);
    return result;
}
