// Calls every material function the package generates, through `extern` prototypes, so that a shader compile
// of this one material proves all 67 of them compile in a real material -- their pins, their types and the HLSL
// of their Custom nodes. Like everything under Packages, it is never compiled in place: copy it into the consuming
// project's DShader/ tree, compile the package's headers (which builds the material functions), then this.
//
//   pwsh -File Plugins/DreamShader/.skill/dsc.ps1 check DShader/Materials/Blender/M_BL_MaterialFunctions_Smoke.dss -Shaders

#pragma material(Domain = "Surface", ShadingModel = "Unlit")

/// @default /Engine/EngineResources/WhiteSquareTexture
static const Texture2D Lut;

/// @group Inputs
uniform float S = 0.5;

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Brick/MF_BL_TexBrick
extern void MF_BL_TexBrick(float3 co, float3 color1, float3 color2, float3 mortarColor, float scale, float mortarSize, float mortarSmooth, float bias, float brickWidth, float rowHeight, float offsetAmount, float offsetFrequency, float squashAmount, float squashFrequency, out float fac, out float3 color);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Checker/MF_BL_TexChecker
extern void MF_BL_TexChecker(float3 co, float3 color1, float3 color2, float scale, out float fac, out float3 color);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Color/MF_BL_MixColor
extern void MF_BL_MixColor(float mode, float fac, float3 color1, float3 color2, float clampFactor, float clampResult, out float3 color);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Color/MF_BL_BrightContrast
extern void MF_BL_BrightContrast(float3 color, float bright, float contrast, out float3 outColor);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Color/MF_BL_Gamma
extern void MF_BL_Gamma(float3 color, float gamma, out float3 outColor);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Color/MF_BL_HueSaturation
extern void MF_BL_HueSaturation(float3 color, float hue, float saturation, float value, float fac, out float3 outColor);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Color/MF_BL_Invert
extern void MF_BL_Invert(float fac, float3 color, out float3 outColor);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Color/MF_BL_SeparateColor
extern void MF_BL_SeparateColor(float3 color, float mode, out float3 outChannels);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Color/MF_BL_CombineColor
extern void MF_BL_CombineColor(float3 channels, float mode, out float3 outColor);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Color/MF_BL_RGBToBW
extern void MF_BL_RGBToBW(float3 color, out float value);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Curves/MF_BL_ColorRamp
extern void MF_BL_ColorRamp(Texture2D lut, float fac, float tableSize, float interpolate, out float3 color, out float alpha);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Curves/MF_BL_FloatCurve
extern void MF_BL_FloatCurve(Texture2D lut, float fac, float value, float minX, float maxX, float tableSize, float extrapolate, out float result);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Curves/MF_BL_RGBCurves
extern void MF_BL_RGBCurves(Texture2D lut, float fac, float3 color, float minX, float maxX, float tableSize, float extrapolate, out float3 result);

