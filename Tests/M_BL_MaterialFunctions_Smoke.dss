/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/WhiteNoise/MF_BL_TexWhiteNoise2D
extern void MF_BL_TexWhiteNoise2D(float2 co, out float value, out float3 color);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/WhiteNoise/MF_BL_TexWhiteNoise3D
extern void MF_BL_TexWhiteNoise3D(float3 co, out float value, out float3 color);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/WhiteNoise/MF_BL_TexWhiteNoise4D
extern void MF_BL_TexWhiteNoise4D(float3 co, float w, out float value, out float3 color);

export void M_BL_MaterialFunctions_Smoke(inout material Base)
{
    float2 UV = UE.TexCoord(Index = 0);
    float3 P = float3(UV.x, UV.y, S);
    float Acc = 0.0;

    float TexBrick_fac;
    float3 TexBrick_color;
    MF_BL_TexBrick(P, P, P, P, S, S, S, S, S, S, S, S, S, S, TexBrick_fac, TexBrick_color);
    Acc += TexBrick_fac + (TexBrick_color.x + TexBrick_color.y + TexBrick_color.z);
    float TexChecker_fac;
    float3 TexChecker_color;
    MF_BL_TexChecker(P, P, P, S, TexChecker_fac, TexChecker_color);
    Acc += TexChecker_fac + (TexChecker_color.x + TexChecker_color.y + TexChecker_color.z);
    float3 MixColor_color;
    MF_BL_MixColor(S, S, P, P, S, S, MixColor_color);
    Acc += (MixColor_color.x + MixColor_color.y + MixColor_color.z);
    float3 BrightContrast_outColor;
    MF_BL_BrightContrast(P, S, S, BrightContrast_outColor);
    Acc += (BrightContrast_outColor.x + BrightContrast_outColor.y + BrightContrast_outColor.z);
    float3 Gamma_outColor;
    MF_BL_Gamma(P, S, Gamma_outColor);
    Acc += (Gamma_outColor.x + Gamma_outColor.y + Gamma_outColor.z);
    float3 HueSaturation_outColor;
    MF_BL_HueSaturation(P, S, S, S, S, HueSaturation_outColor);
    Acc += (HueSaturation_outColor.x + HueSaturation_outColor.y + HueSaturation_outColor.z);
    float3 Invert_outColor;
    MF_BL_Invert(S, P, Invert_outColor);
    Acc += (Invert_outColor.x + Invert_outColor.y + Invert_outColor.z);
    float3 SeparateColor_outChannels;
    MF_BL_SeparateColor(P, S, SeparateColor_outChannels);
    Acc += (SeparateColor_outChannels.x + SeparateColor_outChannels.y + SeparateColor_outChannels.z);
    float3 CombineColor_outColor;
    MF_BL_CombineColor(P, S, CombineColor_outColor);
    Acc += (CombineColor_outColor.x + CombineColor_outColor.y + CombineColor_outColor.z);
    float RGBToBW_value;
    MF_BL_RGBToBW(P, RGBToBW_value);
    Acc += RGBToBW_value;
    float3 ColorRamp_color;
    float ColorRamp_alpha;
    MF_BL_ColorRamp(Lut, S, S, S, ColorRamp_color, ColorRamp_alpha);
    Acc += (ColorRamp_color.x + ColorRamp_color.y + ColorRamp_color.z) + ColorRamp_alpha;
    float FloatCurve_result;
    MF_BL_FloatCurve(Lut, S, S, S, S, S, S, FloatCurve_result);
    Acc += FloatCurve_result;
    float3 RGBCurves_result;
    MF_BL_RGBCurves(Lut, S, P, S, S, S, S, RGBCurves_result);
    Acc += (RGBCurves_result.x + RGBCurves_result.y + RGBCurves_result.z);
    float TexGabor2D_value;
    float TexGabor2D_phase;
    float TexGabor2D_intensity;
    MF_BL_TexGabor2D(P, S, S, S, S, TexGabor2D_value, TexGabor2D_phase, TexGabor2D_intensity);
    Acc += TexGabor2D_value + TexGabor2D_phase + TexGabor2D_intensity;
    float TexGabor3D_value;
    float TexGabor3D_phase;
    float TexGabor3D_intensity;
    MF_BL_TexGabor3D(P, S, S, S, P, TexGabor3D_value, TexGabor3D_phase, TexGabor3D_intensity);
    Acc += TexGabor3D_value + TexGabor3D_phase + TexGabor3D_intensity;
    float TexGradient_fac;
    float3 TexGradient_color;
    MF_BL_TexGradient(P, S, TexGradient_fac, TexGradient_color);
    Acc += TexGradient_fac + (TexGradient_color.x + TexGradient_color.y + TexGradient_color.z);
    float TexMagic_fac;
    float3 TexMagic_color;
    MF_BL_TexMagic(P, S, S, S, TexMagic_fac, TexMagic_color);
    Acc += TexMagic_fac + (TexMagic_color.x + TexMagic_color.y + TexMagic_color.z);
    float Math_value;
    MF_BL_Math(S, S, S, S, S, Math_value);
    Acc += Math_value;
    float VectorMath_value;
    float3 VectorMath_vec;
    MF_BL_VectorMath(S, P, P, P, S, VectorMath_value, VectorMath_vec);
    Acc += VectorMath_value + (VectorMath_vec.x + VectorMath_vec.y + VectorMath_vec.z);
    float MapRange_result;
    MF_BL_MapRange(S, S, S, S, S, S, S, S, MapRange_result);
    Acc += MapRange_result;
    float Clamp_result;
    MF_BL_Clamp(S, S, S, S, Clamp_result);
    Acc += Clamp_result;
    float TexNoise1D_fac;
    float3 TexNoise1D_color;
    MF_BL_TexNoise1D(S, S, S, S, S, S, S, TexNoise1D_fac, TexNoise1D_color);
    Acc += TexNoise1D_fac + (TexNoise1D_color.x + TexNoise1D_color.y + TexNoise1D_color.z);
    float TexNoise2D_fac;
    float3 TexNoise2D_color;
    MF_BL_TexNoise2D(UV, S, S, S, S, S, S, TexNoise2D_fac, TexNoise2D_color);
    Acc += TexNoise2D_fac + (TexNoise2D_color.x + TexNoise2D_color.y + TexNoise2D_color.z);
    float TexNoise3D_fac;
    float3 TexNoise3D_color;
    MF_BL_TexNoise3D(P, S, S, S, S, S, S, TexNoise3D_fac, TexNoise3D_color);
    Acc += TexNoise3D_fac + (TexNoise3D_color.x + TexNoise3D_color.y + TexNoise3D_color.z);
    float TexNoise4D_fac;
    float3 TexNoise4D_color;
    MF_BL_TexNoise4D(P, S, S, S, S, S, S, S, TexNoise4D_fac, TexNoise4D_color);
    Acc += TexNoise4D_fac + (TexNoise4D_color.x + TexNoise4D_color.y + TexNoise4D_color.z);
    float TexNoiseTyped1D_fac;
    float3 TexNoiseTyped1D_color;
    MF_BL_TexNoiseTyped1D(S, S, S, S, S, S, S, S, S, S, TexNoiseTyped1D_fac, TexNoiseTyped1D_color);
    Acc += TexNoiseTyped1D_fac + (TexNoiseTyped1D_color.x + TexNoiseTyped1D_color.y + TexNoiseTyped1D_color.z);
    float TexNoiseTyped2D_fac;
    float3 TexNoiseTyped2D_color;
    MF_BL_TexNoiseTyped2D(UV, S, S, S, S, S, S, S, S, S, TexNoiseTyped2D_fac, TexNoiseTyped2D_color);
    Acc += TexNoiseTyped2D_fac + (TexNoiseTyped2D_color.x + TexNoiseTyped2D_color.y + TexNoiseTyped2D_color.z);
    float TexNoiseTyped3D_fac;
    float3 TexNoiseTyped3D_color;
