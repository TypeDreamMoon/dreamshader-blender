extern void MF_BL_TexVoronoiSmoothF1_3D(float3 co, float scale, float detail, float roughness, float lacunarity, float smoothness, float randomness, float metric, float exponent, float normalize01, out float outDistance, out float3 outColor, out float3 outPosition, out float outW);

