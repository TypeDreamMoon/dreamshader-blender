extern void MF_BL_Math(float operation, float a, float b, float c, float doClamp, out float value);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Math/MF_BL_VectorMath
extern void MF_BL_VectorMath(float operation, float3 a, float3 b, float3 c, float scaleOrIor, out float value, out float3 vec);

/// @asset /Game/DreamShaderPackages/typedreammoon/dreamshader-blender/Math/MF_BL_MapRange
extern void MF_BL_MapRange(float value, float fromMin, float fromMax, float toMin, float toMax, float steps, float interpolation, float doClamp, out float result);

