// Compile gate for @typedreammoon/dreamshader-blender.
//
// This lives in the project tree rather than the package's Examples/ folder on purpose: a .dsm
// under DShader/Packages is never compiled by any path, so an example there proves nothing.
// This one is built by `compile -All` and by the commandlet.
//
// All four dimensions are wired into the output with non-zero weights so none of them can be
// dead-code eliminated — the point is to typecheck and compile every entry point, not to look
// like anything in particular.

import "@typedreammoon/dreamshader-blender/Library/Noise.dsh";

Shader(Name = "Blender/M_BL_TexNoise_Parity")
{
    Properties = {
        ScalarParameter Scale = 5.0 [
            Group="Noise Texture | Inputs"; SortPriority=10;
        ];
        ScalarParameter Detail = 2.0 [
            Group="Noise Texture | Inputs"; SortPriority=20;
        ];
        ScalarParameter Roughness = 0.5 [
            Group="Noise Texture | Inputs"; SortPriority=30;
        ];
        ScalarParameter Lacunarity = 2.0 [
            Group="Noise Texture | Inputs"; SortPriority=40;
        ];
        ScalarParameter Distortion = 0.0 [
            Group="Noise Texture | Inputs"; SortPriority=50;
        ];
        ScalarParameter WCoord = 0.0 [
            Group="Noise Texture | Inputs"; SortPriority=60;
            Description="The 4D variant's W input";
        ];
        ScalarParameter NormalizeOutput = 1.0 [
            Group="Noise Texture | Options"; SortPriority=70;
        ];
    }

    Settings = {
        Domain = "Surface";
        ShadingModel = "Unlit";
    }

    Outputs = {
        float3 EmissiveColor;
        Base.EmissiveColor = EmissiveColor;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float3 p = float3(uv.x, uv.y, 0.0);

        BL::TexNoise1D(uv.x, Scale, Detail, Roughness, Lacunarity, Distortion, NormalizeOutput,
                       Fac1, Color1);
        BL::TexNoise2D(uv, Scale, Detail, Roughness, Lacunarity, Distortion, NormalizeOutput,
                       Fac2, Color2);
        BL::TexNoise3D(p, Scale, Detail, Roughness, Lacunarity, Distortion, NormalizeOutput,
                       Fac3, Color3);
        BL::TexNoise4D(p, WCoord, Scale, Detail, Roughness, Lacunarity, Distortion,
                       NormalizeOutput, Fac4, Color4);

        float3 bands = float3(Fac1, Fac2, Fac4);
        EmissiveColor = bands * 0.5 + Color3 * 0.5;
    }
}
