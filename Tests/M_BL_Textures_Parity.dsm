// Compile gate for @typedreammoon/dreamshader-blender.
//
// A .dsm under DShader/Packages is never compiled by any path, so this file proves nothing where
// it sits. Copy it into the consuming project's own tree — DShader/Materials/Blender/ by
// convention — and build that copy.
//
// Every public entry point is wired into the output with a non-zero weight so none can be dead-
// code eliminated. Every dropdown is a parameter rather than a literal on purpose: a dynamic
// selector forces all of that node's variants through the shader compiler, which is the point of
// a gate and the opposite of what you want in a real material.

import "@typedreammoon/dreamshader-blender/Library/Blender.dsh";

Shader(Name = "Blender/M_BL_Textures_Parity")
{
    Properties = {
        ScalarParameter Scale = 5.0 [
            Group="Shared | Inputs"; SortPriority=10;
        ];
        ScalarParameter Detail = 2.0 [
            Group="Shared | Inputs"; SortPriority=20;
        ];
        ScalarParameter Roughness = 0.5 [
            Group="Shared | Inputs"; SortPriority=30;
        ];
        ScalarParameter Lacunarity = 2.0 [
            Group="Shared | Inputs"; SortPriority=40;
        ];
        ScalarParameter Distortion = 0.3 [
            Group="Shared | Inputs"; SortPriority=50;
        ];
        ScalarParameter WCoord = 0.5 [
            Group="Shared | Inputs"; SortPriority=60;
        ];
        ScalarParameter NoiseOffset = 0.0 [
            Group="Noise | Inputs"; SortPriority=70;
        ];
        ScalarParameter NoiseGain = 1.0 [
            Group="Noise | Inputs"; SortPriority=80;
        ];
        ScalarParameter NoiseType = 0.0 [
            Group="Noise | Options"; SortPriority=90;
            Description="0 fBM, 1 Multifractal, 2 Hybrid, 3 Ridged, 4 Hetero Terrain";
        ];
        // Not named `Normalize`: the 19 math builtins shadow same-named properties inside a
        // Graph block, silently. `normalize` is one of them.
        ScalarParameter NormalizeOutput = 1.0 [
            Group="Noise | Options"; SortPriority=100;
        ];

        ScalarParameter GradientType = 0.0 [
            Group="Gradient | Options"; SortPriority=110;
            Description="0 Linear .. 6 Radial";
        ];

        ScalarParameter WaveType = 0.0 [
            Group="Wave | Options"; SortPriority=120;
        ];
        ScalarParameter WaveDirection = 0.0 [
            Group="Wave | Options"; SortPriority=130;
        ];
        ScalarParameter WaveProfile = 0.0 [
            Group="Wave | Options"; SortPriority=140;
        ];

        ScalarParameter MagicDepth = 2.0 [
            Group="Magic | Options"; SortPriority=150;
        ];
        ScalarParameter VorRandomness = 1.0 [
            Group="Voronoi | Inputs"; SortPriority=160;
        ];
        ScalarParameter VorSmoothness = 1.0 [
            Group="Voronoi | Inputs"; SortPriority=170;
        ];
        ScalarParameter VorExponent = 0.5 [
            Group="Voronoi | Inputs"; SortPriority=180;
        ];
        TextureObjectParameter CurveLut = Path(Engine, "EngineResources/WhiteSquareTexture") [
            Group="Curves | Inputs"; SortPriority=310;
            Description="1 x N RGBA LUT holding the baked curve or ramp";
        ];
        ScalarParameter LutSize = 32.0 [
            Group="Curves | Inputs"; SortPriority=320;
        ];
        ScalarParameter CurveExtrapolate = 0.0 [
            Group="Curves | Options"; SortPriority=330;
        ];
        ScalarParameter MathOp = 0.0 [
            Group="Converter | Options"; SortPriority=230;
        ];
        ScalarParameter VecMathOp = 0.0 [
            Group="Converter | Options"; SortPriority=240;
        ];
        ScalarParameter MixMode = 0.0 [
            Group="Color | Options"; SortPriority=250;
        ];
        ScalarParameter SepCombMode = 0.0 [
            Group="Color | Options"; SortPriority=260;
        ];
        ScalarParameter MapInterp = 0.0 [
            Group="Converter | Options"; SortPriority=270;
        ];
        ScalarParameter MappingType = 0.0 [
            Group="Vector | Options"; SortPriority=280;
        ];
        ScalarParameter RotateType = 0.0 [
            Group="Vector | Options"; SortPriority=290;
        ];
        ScalarParameter UnitScale = 100.0 [
            Group="Space | Inputs"; SortPriority=300;
        ];
        ScalarParameter GaborFrequency = 2.0 [
            Group="Gabor | Inputs"; SortPriority=200;
        ];
        ScalarParameter GaborAnisotropy = 1.0 [
            Group="Gabor | Inputs"; SortPriority=210;
        ];
        ScalarParameter GaborOrientation = 0.7853982 [
            Group="Gabor | Inputs"; SortPriority=220;
        ];
        ScalarParameter VorMetric = 0.0 [
            Group="Voronoi | Options"; SortPriority=190;
            Description="0 Euclidean, 1 Manhattan, 2 Chebychev, 3 Minkowski";
        ];
    }

    Settings = {
        Domain = "Surface";
        ShadingModel = "Unlit";
    }

    Outputs = {
        float3 EmissiveColor;
        Base.EmissiveColor = EmissiveColor;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float3 p = float3(uv.x, uv.y, 0.0);
        float3 white = float3(1.0, 1.0, 1.0);
        float3 black = float3(0.0, 0.0, 0.0);
        float3 grey = float3(0.5, 0.5, 0.5);

        // Noise Texture — fBM shorthand, all four dimensions.
        BL::TexNoise1D(uv.x, Scale, Detail, Roughness, Lacunarity, Distortion, NormalizeOutput,
                       NFac1, NCol1);
        BL::TexNoise2D(uv, Scale, Detail, Roughness, Lacunarity, Distortion, NormalizeOutput,
                       NFac2, NCol2);
        BL::TexNoise3D(p, Scale, Detail, Roughness, Lacunarity, Distortion, NormalizeOutput,
                       NFac3, NCol3);
        BL::TexNoise4D(p, WCoord, Scale, Detail, Roughness, Lacunarity, Distortion,
                       NormalizeOutput, NFac4, NCol4);

        // Noise Texture — full node, all four dimensions, dynamic type.
        BL::TexNoiseTyped1D(uv.x, Scale, Detail, Roughness, Lacunarity, NoiseOffset, NoiseGain,
                            Distortion, NoiseType, NormalizeOutput, TFac1, TCol1);
        BL::TexNoiseTyped2D(uv, Scale, Detail, Roughness, Lacunarity, NoiseOffset, NoiseGain,
                            Distortion, NoiseType, NormalizeOutput, TFac2, TCol2);
        BL::TexNoiseTyped3D(p, Scale, Detail, Roughness, Lacunarity, NoiseOffset, NoiseGain,
                            Distortion, NoiseType, NormalizeOutput, TFac3, TCol3);
        BL::TexNoiseTyped4D(p, WCoord, Scale, Detail, Roughness, Lacunarity, NoiseOffset,
                            NoiseGain, Distortion, NoiseType, NormalizeOutput, TFac4, TCol4);

        // White Noise, all four dimensions.
        BL::TexWhiteNoise1D(uv.x, WFac1, WCol1);
        BL::TexWhiteNoise2D(uv, WFac2, WCol2);
        BL::TexWhiteNoise3D(p, WFac3, WCol3);
        BL::TexWhiteNoise4D(p, WCoord, WFac4, WCol4);

        // The single-variant nodes.
        BL::TexChecker(p, white, black, Scale, ChkFac, ChkCol);
        BL::TexGradient(p, GradientType, GrdFac, GrdCol);
        BL::TexMagic(p, Scale, MagicDepth, Distortion, MagFac, MagCol);
        BL::TexWave(p, Scale, Distortion, Detail, Scale, Roughness, WCoord,
                    WaveType, WaveDirection, WaveProfile, WavFac, WavCol);
        BL::TexBrick(p, white, grey, black, Scale, 0.02, 0.1, 0.0, 0.5, 0.25,
                     0.5, 2.0, 1.0, 2.0, BrkFac, BrkCol);


        // Voronoi — every feature, every dimension. Metric stays dynamic.
        VAcc = 0.0;
        VCol = float3(0.0, 0.0, 0.0);
        BL::TexVoronoiF1_1D(uv.x, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD1, VC1, VP1, VW1);
        VAcc = VAcc + VD1 + VW1;
        VCol = VCol + VC1 + VP1;
        BL::TexVoronoiSmoothF1_1D(uv.x, Scale, Detail, Roughness, Lacunarity,
                              VorSmoothness, VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD2, VC2, VP2, VW2);
        VAcc = VAcc + VD2 + VW2;
        VCol = VCol + VC2 + VP2;
        BL::TexVoronoiF2_1D(uv.x, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD3, VC3, VP3, VW3);
        VAcc = VAcc + VD3 + VW3;
        VCol = VCol + VC3 + VP3;
        BL::TexVoronoiDistToEdge_1D(uv.x, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, NormalizeOutput, VD4);
        VAcc = VAcc + VD4;
        BL::TexVoronoiRadius_1D(uv.x, Scale, VorRandomness, VD5);
        VAcc = VAcc + VD5;
        BL::TexVoronoiF1_2D(uv, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD6, VC6, VP6, VW6);
        VAcc = VAcc + VD6 + VW6;
        VCol = VCol + VC6 + VP6;
        BL::TexVoronoiSmoothF1_2D(uv, Scale, Detail, Roughness, Lacunarity,
                              VorSmoothness, VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD7, VC7, VP7, VW7);
        VAcc = VAcc + VD7 + VW7;
        VCol = VCol + VC7 + VP7;
        BL::TexVoronoiF2_2D(uv, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD8, VC8, VP8, VW8);
        VAcc = VAcc + VD8 + VW8;
        VCol = VCol + VC8 + VP8;
        BL::TexVoronoiDistToEdge_2D(uv, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, NormalizeOutput, VD9);
        VAcc = VAcc + VD9;
        BL::TexVoronoiRadius_2D(uv, Scale, VorRandomness, VD10);
        VAcc = VAcc + VD10;
        BL::TexVoronoiF1_3D(p, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD11, VC11, VP11, VW11);
        VAcc = VAcc + VD11 + VW11;
        VCol = VCol + VC11 + VP11;
        BL::TexVoronoiSmoothF1_3D(p, Scale, Detail, Roughness, Lacunarity,
                              VorSmoothness, VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD12, VC12, VP12, VW12);
        VAcc = VAcc + VD12 + VW12;
        VCol = VCol + VC12 + VP12;
        BL::TexVoronoiF2_3D(p, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD13, VC13, VP13, VW13);
        VAcc = VAcc + VD13 + VW13;
        VCol = VCol + VC13 + VP13;
        BL::TexVoronoiDistToEdge_3D(p, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, NormalizeOutput, VD14);
        VAcc = VAcc + VD14;
        BL::TexVoronoiRadius_3D(p, Scale, VorRandomness, VD15);
        VAcc = VAcc + VD15;
        BL::TexVoronoiF1_4D(p, WCoord, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD16, VC16, VP16, VW16);
        VAcc = VAcc + VD16 + VW16;
        VCol = VCol + VC16 + VP16;
        BL::TexVoronoiSmoothF1_4D(p, WCoord, Scale, Detail, Roughness, Lacunarity,
                              VorSmoothness, VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD17, VC17, VP17, VW17);
        VAcc = VAcc + VD17 + VW17;
        VCol = VCol + VC17 + VP17;
        BL::TexVoronoiF2_4D(p, WCoord, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, VorMetric, VorExponent, NormalizeOutput,
                              VD18, VC18, VP18, VW18);
        VAcc = VAcc + VD18 + VW18;
        VCol = VCol + VC18 + VP18;
        BL::TexVoronoiDistToEdge_4D(p, WCoord, Scale, Detail, Roughness, Lacunarity,
                              VorRandomness, NormalizeOutput, VD19);
        VAcc = VAcc + VD19;
        BL::TexVoronoiRadius_4D(p, WCoord, Scale, VorRandomness, VD20);
        VAcc = VAcc + VD20;

        // Gabor, both types.
        float3 gaborDir = float3(0.0, 0.0, 1.0);
        BL::TexGabor2D(p, Scale, GaborFrequency, GaborAnisotropy, GaborOrientation,
                       GbV2, GbP2, GbI2);
        BL::TexGabor3D(p, Scale, GaborFrequency, GaborAnisotropy, gaborDir,
                       GbV3, GbP3, GbI3);
        VAcc = VAcc + GbV2 + GbP2 + GbI2 + GbV3 + GbP3 + GbI3;

        // Converter / Color / Vector, all dropdowns dynamic.
        BL::Math(MathOp, uv.x, uv.y, WCoord, 0.0, MathV);
        BL::VectorMath(VecMathOp, p, grey, white, Scale, VecMathVal, VecMathVec);
        BL::MapRange(uv.x, 0.0, 1.0, -1.0, 2.0, 4.0, MapInterp, 1.0, MapV);
        BL::Clamp(uv.y, 0.2, 0.8, SepCombMode, ClampV);
        BL::MixColor(MixMode, uv.x, white, grey, 1.0, 1.0, MixCol);
        BL::BrightContrast(grey, uv.x, uv.y, BcCol);
        BL::Gamma(grey, 2.2, GamCol);
        BL::HueSaturation(grey, uv.x, uv.y, 1.0, 1.0, HsvCol);
        BL::Invert(uv.x, grey, InvCol);
        BL::SeparateColor(grey, SepCombMode, SepCol);
        BL::CombineColor(SepCol, SepCombMode, CombCol);
        BL::RGBToBW(grey, BwV);
        BL::Mapping(MappingType, p, grey, white, float3(2.0, 2.0, 2.0), MapVec);
        BL::VectorRotate(RotateType, p, grey, white, uv.x, white, 0.0, RotVec);
        BL::Normal(white, p, NrmVec, NrmDot);
        BL::SeparateXYZ(p, SepX, SepY, SepZ);
        BL::CombineXYZ(SepX, SepY, SepZ, CombVec);

        // Coordinate spaces.
        BL::CoordGenerated(GenCo);
        BL::CoordObject(UnitScale, ObjCo);
        BL::CoordUV(0.0, UvCo);
        BL::CoordNormal(NrmCo);
        BL::ToUnrealPoint(ObjCo, UnitScale, BackCo);

        // Blackbody, Wavelength and the curve lookups.
        BL::Blackbody(uv.x * 12000.0, BbCol);
        BL::Wavelength(380.0 + uv.y * 400.0, WlCol);
        BL::ColorRamp(CurveLut, uv.x, LutSize, 1.0, RampCol, RampA);
        BL::FloatCurve(CurveLut, 1.0, uv.y, 0.0, 1.0, LutSize, CurveExtrapolate, FcV);
        BL::RGBCurves(CurveLut, 1.0, p, 0.0, 1.0, LutSize, CurveExtrapolate, RcCol);

        float3 curveAcc = BbCol + WlCol + RampCol + RcCol + float3(RampA, FcV, 0.0);

        float3 convAcc = float3(MathV, MapV, ClampV) + float3(VecMathVal, BwV, NrmDot)
                       + VecMathVec + MixCol + BcCol + GamCol + HsvCol + InvCol + CombCol
                       + MapVec + RotVec + NrmVec + CombVec
                       + GenCo + ObjCo + UvCo + NrmCo + BackCo + curveAcc;

        float3 noiseFacs = float3(NFac1, NFac2, NFac4);
        float3 typedFacs = float3(TFac1, TFac2, TFac4);
        float3 whiteFacs = float3(WFac1, WFac2, WFac4);
        float3 otherFacs = float3(ChkFac, GrdFac, MagFac);
        float3 tailFacs = float3(WavFac, BrkFac, NFac3);
        float3 restFacs = float3(TFac3, WFac3, NFac3);

        float3 cols = NCol1 + NCol2 + NCol3 + NCol4 + TCol1 + TCol2 + TCol3 + TCol4;
        float3 cols2 = WCol1 + WCol2 + WCol3 + WCol4 + ChkCol + GrdCol + MagCol + WavCol + BrkCol;

        EmissiveColor = (noiseFacs + typedFacs + whiteFacs + otherFacs + tailFacs + restFacs
                        + cols + cols2 + VCol + float3(VAcc, VAcc, VAcc) + convAcc) * 0.005;
    }
}
