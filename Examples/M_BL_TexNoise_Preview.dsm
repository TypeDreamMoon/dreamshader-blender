// Noise Texture, 3D, driven from UV — the smallest thing that shows the node working.
//
// Examples inside a package are never compiled by the plugin. Copy this out of
// DShader/Packages into DShader/ (or any subdirectory that is not Packages) to build it.

import "@typedreammoon/dreamshader-blender/Library/Noise.dsh";

Shader(Name = "Blender/M_BL_TexNoise_Preview")
{
    Properties = {
        ScalarParameter Scale = 5.0 [
            Group="Noise Texture | Inputs"; SortPriority=10;
            Description="Blender's Scale input — multiplies the coordinate";
        ];
        ScalarParameter Detail = 2.0 [
            Group="Noise Texture | Inputs"; SortPriority=20;
            Description="Octave count, clamped to 0..15 as in Blender";
        ];
        ScalarParameter Roughness = 0.5 [
            Group="Noise Texture | Inputs"; SortPriority=30;
            Description="Amplitude falloff per octave";
        ];
        ScalarParameter Lacunarity = 2.0 [
            Group="Noise Texture | Inputs"; SortPriority=40;
            Description="Frequency gain per octave";
        ];
        ScalarParameter Distortion = 0.0 [
            Group="Noise Texture | Inputs"; SortPriority=50;
            Description="Warps the coordinate by noise before sampling";
        ];
        // Not named `Normalize`: the 19 math builtins shadow same-named properties inside a
        // Graph block, silently. `normalize` is one of them.
        ScalarParameter NormalizeOutput = 1.0 [
            Group="Noise Texture | Options"; SortPriority=60;
            Description="Blender's Normalize checkbox — 1 remaps to 0..1, 0 leaves it signed";
        ];
    }

    Settings = {
        Domain = "Surface";
        ShadingModel = "Unlit";
    }

    Outputs = {
        float3 EmissiveColor;
        Base.EmissiveColor = EmissiveColor;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float3 p = float3(uv.x, uv.y, 0.0);

        BL::TexNoise3D(p, Scale, Detail, Roughness, Lacunarity, Distortion, NormalizeOutput,
                       Fac, Color);

        EmissiveColor = float3(Fac, Fac, Fac);
    }
}
